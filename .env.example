VITE_KNOCK_PUBLIC_API_KEY=pk_...   # Knock PUBLIC key (starts with pk_), never sk_
VITE_KNOCK_FEED_CHANNEL_ID=

# Supabase — the portal's backend. Use the project URL and the anon /
# publishable key (safe in the browser). NEVER put the service_role secret here.
#
# Deploying to another host (Vercel, Netlify, Cloudflare, any static host) needs
# no manual config step: set these two variables in that host's environment and
# build. scripts/build-sites.mjs writes /aoh-config.js from them, so the
# deployed app is connected to the backend automatically.
#
# Without either pair the build keeps the committed public/aoh-config.js, and a
# host can still edit /aoh-config.js in place after upload (no rebuild).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Vite-style aliases, also accepted by the build (Vite compiles them in too).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
