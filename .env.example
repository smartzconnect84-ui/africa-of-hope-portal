VITE_KNOCK_PUBLIC_API_KEY=pk_...   # Knock PUBLIC key (starts with pk_), never sk_
VITE_KNOCK_FEED_CHANNEL_ID=

# Supabase — the portal's backend. Use the project URL and the anon /
# publishable key (safe in the browser). NEVER put the service_role secret here.
#
# Deploying to another host (Vercel, Netlify, Cloudflare, any static host) needs
# no manual config step: set these two variables in that host's environment and
# build. scripts/build-sites.mjs writes /aoh-config.js from them, so the
# deployed app is connected to the backend automatically.
#
# Without either pair the build keeps the committed public/aoh-config.js, and a
# host can still edit /aoh-config.js in place after upload (no rebuild).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Vite-style aliases, also accepted by the build (Vite compiles them in too).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# The origin this deployment is served from. Set it on every host: the build
# registers it in the Supabase Auth redirect allowlist so sign-in, confirmation
# and password-reset links return to this domain instead of site_url.
# Netlify/Vercel/Cloudflare Pages inject DEPLOY_PRIME_URL, CF_PAGES_URL or
# VERCEL_URL, which are used automatically when SITE_URL is not set.
SITE_URL=https://your-domain.example

# Supabase Management API token (Project Settings → API → access token).
# Needed only for the allowlist registration above; without it the build says
# the origin could not be registered and continues. Never ship this to a
# browser — it is a server-side deploy credential, not a public key.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
