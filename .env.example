VITE_KNOCK_PUBLIC_API_KEY=pk_...   # Knock PUBLIC key (starts with pk_), never sk_
VITE_KNOCK_FEED_CHANNEL_ID=

# Supabase — the portal's backend. Use the project URL and the anon /
# publishable key (safe in the browser). NEVER put the service_role secret here.
# Values live in .env (gitignored) or in the deploy target's secrets.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
